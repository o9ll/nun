# Public URL clients use (no trailing slash). Plugin baseUrl + wss:// must reach this host.
PUBLIC_URL=http://127.0.0.1:8787

PORT=8787

# Discord application — must match CLIENT_ID in src/userplugins/_api/nunOnlineServices/constants.ts
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot token with permissions to add members (guilds.join flow). Optional if GUILD_ID is empty.
DISCORD_BOT_TOKEN=

# Users must be in this guild before the VI socket accepts them. Leave empty to skip the gate.
GUILD_ID=
